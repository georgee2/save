<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # ============================================
    # SECURITY: Block cPanel access
    # ============================================
    # Block access to /cpanel
    RewriteCond %{REQUEST_URI} ^/cpanel [NC]
    RewriteRule ^.*$ / [R=301,L]
    
    # Block access to common cPanel paths
    RewriteCond %{REQUEST_URI} ^/(webmail|whm|2082|2083|2086|2087) [NC]
    RewriteRule ^.*$ / [R=301,L]
    
    # Route to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ /public/$1 [L]
    
    # Handle root
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^ /public/index.php [L]
</IfModule>

# ============================================
# SECURITY: Block access to sensitive files
# ============================================
# Block access to .env file
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Block access to .env.example
<Files .env.example>
    Order allow,deny
    Deny from all
</Files>

# Block access to .env.backup or any .env* file
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to composer files
<Files composer.json>
    Order allow,deny
    Deny from all
</Files>

<Files composer.lock>
    Order allow,deny
    Deny from all
</Files>

# Block access to package.json
<Files package.json>
    Order allow,deny
    Deny from all
</Files>

<Files package-lock.json>
    Order allow,deny
    Deny from all
</Files>

# Block access to artisan
<Files artisan>
    Order allow,deny
    Deny from all
</Files>

# Block access to readme/changelog files
<FilesMatch "(README|CHANGELOG|LICENSE|readme|changelog|license)\.(md|txt|html)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to .git directory
<IfModule mod_rewrite.c>
    RewriteRule ^\.git - [F,L]
</IfModule>

# Block access to sensitive directories
<IfModule mod_rewrite.c>
    RewriteRule ^app/ - [F,L]
    RewriteRule ^bootstrap/ - [F,L]
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^resources/ - [F,L]
    RewriteRule ^routes/ - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^tests/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^Modules/ - [F,L]
</IfModule>

# Block access to hidden files (starting with .)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to backup files
<FilesMatch "\.(bak|backup|old|save|sql|tar|gz|zip)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to log files
<FilesMatch "\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to PHP files in uploads (prevent execution)
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/storage/.*\.php$
    RewriteRule ^ - [F,L]
</IfModule>

# ============================================
# SECURITY: HTTP Security Headers
# ============================================
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remove PHP version exposure
    Header unset X-Powered-By
    
    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ============================================
# PERFORMANCE: Compression & Caching
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
